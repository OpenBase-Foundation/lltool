# SQLite (default)
DB_DSN=sqlite:database/database.sqlite
DB_USER=
DB_PASS=

# MySQL example (preferred for production). Uncomment and set values
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=lltool
# DB_USER=lltool_user
# DB_PASS=supersecret

# Alternatively you can set a DSN directly, e.g.:
# DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=lltool;charset=utf8mb4

# For PostgreSQL set a postgres DSN in DB_DSN
